rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Superadmin';
    }

    function isOwnerOrAdmin(userId) {
      return signedIn() && (request.auth.uid == userId || isSuperadmin());
    }

    function hasNoPasswordFields(data) {
      return !data.keys().hasAny(['password', 'passwordHash', 'hashedPassword']);
    }

    function farmOwnedByCurrentUser(farmPath) {
      return exists(farmPath) && (
        get(farmPath).data.ownerId == request.auth.uid
        || get(farmPath).data.owner_id == request.auth.uid
        || get(farmPath).data.farmerId == request.auth.uid
        || get(farmPath).data.farmer_id == request.auth.uid
        || get(farmPath).data.ownerId == 'user_' + request.auth.uid
        || get(farmPath).data.owner_id == 'user_' + request.auth.uid
        || get(farmPath).data.farmerId == 'user_' + request.auth.uid
        || get(farmPath).data.farmer_id == 'user_' + request.auth.uid
      );
    }

    function ownsFarm(farmId) {
      return signedIn() && (
        farmOwnedByCurrentUser(/databases/$(database)/documents/farms/$(farmId))
        || farmOwnedByCurrentUser(/databases/$(database)/documents/farms/farm_$(farmId))
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if hasNoPasswordFields(request.resource.data)
        && signedIn() && (request.auth.uid == userId || isSuperadmin());
      allow update: if hasNoPasswordFields(request.resource.data)
        && signedIn() && (request.auth.uid == userId || isSuperadmin());
      allow delete: if isSuperadmin();
    }

    match /farms/{farmId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /ponds/{pondId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /approvals/{approvalId} {
      allow read: if isSuperadmin() || (signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
        || approvalId == request.auth.uid
      ));
      allow create: if hasNoPasswordFields(request.resource.data) && (
        isSuperadmin()
        || (signedIn() && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.uid == request.auth.uid
          || approvalId == request.auth.uid
        ))
      );
      allow update, delete: if isSuperadmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperadmin();
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'actorId', 'actor', 'actorRole', 'type', 'action', 'detail', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if signedIn();
      allow create: if isSuperadmin() || (
        request.resource.data.farmId is string
        && ownsFarm(request.resource.data.farmId)
      );
      allow update, delete: if isSuperadmin();
    }

    match /mail/{mailId} {
      allow create: if isSuperadmin();
      allow read, update, delete: if false;
    }
  }
}
