rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Superadmin';
    }

    function isOwnerOrAdmin(userId) {
      return signedIn() && (request.auth.uid == userId || isSuperadmin());
    }

    function hasNoPasswordFields(data) {
      return !data.keys().hasAny([
        'password', 'passwordHash', 'hashedPassword', 'password_hash', 'hashed_password'
      ]);
    }

    function hasRequiredApprovalDetails(data) {
      return data.keys().hasAll([
        'firstName', 'middleName', 'lastName', 'farmName', 'city',
        'barangay', 'province', 'zip', 'email'
      ])
        && data.firstName is string
        && data.middleName is string
        && data.lastName is string
        && data.farmName is string
        && data.city is string
        && data.barangay is string
        && data.province is string
        && (data.zip is string || data.zip is int)
        && data.email is string;
    }

    function farmOwnedByCurrentUser(farmPath) {
      return exists(farmPath) && (
        get(farmPath).data.get('ownerId', '') == request.auth.uid
        || get(farmPath).data.get('owner_id', '') == request.auth.uid
        || get(farmPath).data.get('farmerId', '') == request.auth.uid
        || get(farmPath).data.get('farmer_id', '') == request.auth.uid
        || get(farmPath).data.get('ownerId', '') == 'user_' + request.auth.uid
        || get(farmPath).data.get('owner_id', '') == 'user_' + request.auth.uid
        || get(farmPath).data.get('farmerId', '') == 'user_' + request.auth.uid
        || get(farmPath).data.get('farmer_id', '') == 'user_' + request.auth.uid
      );
    }

    function ownsFarm(farmId) {
      return signedIn() && (
        farmOwnedByCurrentUser(/databases/$(database)/documents/farms/$(farmId))
        || farmOwnedByCurrentUser(/databases/$(database)/documents/farms/farm_$(farmId))
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if hasNoPasswordFields(request.resource.data) && isSuperadmin();
      allow update: if hasNoPasswordFields(request.resource.data) && (
        isSuperadmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'middleName', 'lastName', 'mobile', 'email',
            'street', 'barangay', 'city', 'lastSeen'
          ]))
      );
      allow delete: if isSuperadmin();
    }

    match /farms/{farmId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /ponds/{pondId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /approvals/{approvalId} {
      allow read: if isSuperadmin() || (signedIn() && (
        resource.data.get('userId', '') == request.auth.uid
        || resource.data.get('uid', '') == request.auth.uid
        || approvalId == request.auth.uid
      ));
      allow create: if hasNoPasswordFields(request.resource.data)
        && hasRequiredApprovalDetails(request.resource.data)
        && request.resource.data.get('status', '') == 'Pending'
        && (
        isSuperadmin()
        || (signedIn() && (
          request.resource.data.get('userId', '') == request.auth.uid
          || request.resource.data.get('uid', '') == request.auth.uid
          || approvalId == request.auth.uid
        ))
      );
      allow update, delete: if isSuperadmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperadmin();
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'actorId', 'actor', 'actorRole', 'type', 'action', 'detail', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if signedIn();
      allow create: if isSuperadmin() || (
        request.resource.data.farmId is string
        && ownsFarm(request.resource.data.farmId)
      );
      allow update, delete: if isSuperadmin();
    }

    match /mail/{mailId} {
      allow create: if isSuperadmin();
      allow read, update, delete: if false;
    }
  }
}
